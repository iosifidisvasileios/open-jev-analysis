    "criteria": {
      "benign": "Does not meet the positive class definition above.",
      "injection": "Meets the positive class definition above."
    }
  },
  "dataset": {
    "name": "deepset",
    "text_column": "text",
    "classes": [
      "benign",
      "injection"
